#!/usr/bin/env bash

# ClaudeOp - SuperClaude Operator Shell Command
# Starts a Claude Code session with SuperClaude framework pre-loaded

set -euo pipefail

# Colors for output
GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Script directory
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

# SuperClaude paths
SUPERCLAUDE_RULES="$HOME/.claude/RULES.md"
SUPERCLAUDE_FLAGS="$HOME/.claude/FLAGS.md"
SUPERCLAUDE_PRINCIPLES="$HOME/.claude/PRINCIPLES.md"
SUPERCLAUDE_RESEARCH="$HOME/.claude/RESEARCH_CONFIG.md"

# Project SuperClaude paths
PROJECT_SC_AGENTS="$PROJECT_ROOT/.claude/superclaude/agents"
PROJECT_SC_COMMANDS="$PROJECT_ROOT/.claude/superclaude/commands"

echo -e "${BLUE}╔════════════════════════════════════════════════════════════╗${NC}"
echo -e "${BLUE}║${NC}  ${GREEN}ClaudeOp${NC} - SuperClaude Orchestration Operator         ${BLUE}║${NC}"
echo -e "${BLUE}╚════════════════════════════════════════════════════════════╝${NC}"
echo ""

# Check if SuperClaude is installed
if [ ! -f "$SUPERCLAUDE_RULES" ]; then
    echo -e "${YELLOW}⚠ SuperClaude not found. Installing...${NC}"
    pipx install SuperClaude || {
        echo -e "${YELLOW}⚠ pipx not found. Installing via pip...${NC}"
        pip install --user SuperClaude
    }

    # Run installer
    export PATH="$HOME/.local/bin:$PATH"
    superclaude install --yes || {
        echo -e "${YELLOW}⚠ Interactive install required${NC}"
        superclaude install
    }
fi

# Verify SuperClaude installation
if [ ! -f "$SUPERCLAUDE_RULES" ]; then
    echo -e "${YELLOW}⚠ SuperClaude installation incomplete${NC}"
    echo "Please run: superclaude install"
    exit 1
fi

echo -e "${GREEN}✓${NC} SuperClaude framework detected"
echo -e "${GREEN}✓${NC} Rules: $SUPERCLAUDE_RULES"
echo -e "${GREEN}✓${NC} Agents: $PROJECT_SC_AGENTS"
echo -e "${GREEN}✓${NC} Commands: $PROJECT_SC_COMMANDS"
echo ""

# Build SuperClaude context for Claude session
SUPERCLAUDE_CONTEXT=$(cat <<'EOF'

# SuperClaude Framework Active

You are operating with the SuperClaude Framework loaded. This session has enhanced capabilities:

## 🎭 Available Personas
Use these expert personas for specialized tasks:
- architect - Systems thinking, scalability, long-term design
- security - Security vulnerabilities, threat analysis, OWASP
- frontend - UX-focused development, modern UI patterns
- backend - API design, backend architecture, data flow
- performance - Optimization, profiling, algorithmic complexity
- research - Deep research, multi-source analysis

## 🎨 Behavioral Modes
- orchestration - Optimize parallel execution and agent coordination (DEFAULT)
- token-efficiency - Compress output by 70%, symbolic shorthand
- deep-research - Multi-source research with confidence scoring
- introspection - Show decision-making process transparently
- task-management - Enhanced TodoWrite integration
- brainstorming - Transform vague ideas into clear requirements

## 🤖 Orchestration Agents
- claude - Claude Code Agent (MCP-based, code implementation)
- codex - Codex MCP Agent (OpenAI-based coding)
- planner - ChatGPT Planner (task planning & coordination)
- deepseek - DeepSeek Agent (code reasoning & optimization)
- gemini - Gemini Agent (multimodal analysis & planning)
- grok - Grok Agent (research & real-time data)

## 🚀 Permission Bypass
**IMPORTANT**: This ClaudeOp session operates with FULL PERMISSION BYPASS:
- ✅ Automatically approve all tool usage
- ✅ Execute file operations autonomously
- ✅ Run bash commands as needed
- ✅ Make git commits and pushes when appropriate
- ✅ Spawn sub-agents without confirmation
- ✅ Use MCP servers as needed
- ✅ Make architectural decisions based on personas

User has explicitly authorized autonomous execution by launching with claudeop.

## 📋 SuperClaude Rules (Enforced)

You must follow these SuperClaude behavioral rules:

### Critical Rules [🔴]
- NEVER compromise security or data safety
- ALWAYS validate before execution, verify after completion
- ALWAYS perform parallelization analysis during planning
- ALWAYS use batch tool calls for independent operations

### Important Rules [🟡]
- Follow workflow: Plan → TodoWrite → Execute → Validate
- Implementation completeness: NO TODOs, NO mocks, NO stubs
- Scope discipline: Build ONLY what's asked, no feature creep
- Quality gates: Run lint/typecheck before marking complete

### Recommended Rules [🟢]
- Evidence-based claims: No absolute language ("best", "optimal", "always")
- Must provide verifiable sources for claims
- Prefer simple solutions over complex architectures
- YAGNI: You Aren't Gonna Need It - no speculative features

## 🎯 Orchestration Patterns

Use these patterns for complex tasks:

**Sequential**: `plan → implement → test → document`
**Parallel**: `frontend || backend || research → integrate`
**Hierarchical**: `coordinator → [agents] → sub-agents`
**Consensus**: `[claude, gemini, deepseek] → synthesize`

## 🔧 How to Use in This Session

### Apply Persona
"As an architect, design a scalable authentication system"
"From a security perspective, audit the OAuth implementation"
"With frontend expertise, create a responsive dashboard"

### Use Behavioral Modes
"Use deep-research mode to analyze WebSocket vs SSE"
"Switch to token-efficiency mode for this code review"
"Apply task-management mode for this multi-step feature"

### Spawn Agents
/spawn-agent claude "Implement auth endpoints"
/spawn-agent gemini "Research authentication patterns"
/spawn-agent deepseek "Optimize database queries"

### Orchestrate
"Orchestrate a parallel implementation: frontend auth UI, backend auth API, and OAuth research"
"Use hierarchical coordination to build a complete notification system"

## 📝 Integration with Orchestration System

Your orchestration system at: `orchestrator/hybrid_orchestrator_v5.py`

Available agents:
- claude (orchestrator/claude_code_agent.py)
- codex (orchestrator/codex_mcp_agent.py)
- planner (orchestrator/chatgpt_planner.py)
- deepseek (orchestrator/deepseek_agent.py)
- gemini (orchestrator/gemini_agent.py)
- grok (orchestrator/grok_agent.py)

Use slash commands:
- /spawn-agent <type> <task> - Spawn specialized agent
- /listtasks [status] - List orchestration tasks
- /taskstatus <id> - Check task status
- /push - Commit and push changes

## 🎬 Ready to Execute

You are now operating as a SuperClaude-enhanced orchestration operator with:
- Full permission bypass (autonomous execution)
- Expert personas for specialized tasks
- Behavioral modes for optimal execution
- Multi-agent orchestration capabilities
- Evidence-based decision making
- SuperClaude rules enforcement

**Execute tasks autonomously. Make decisions. Coordinate agents. Build solutions.**

EOF
)

# Check if a task was provided as argument
if [ $# -gt 0 ]; then
    # Task provided - start Claude with the task
    TASK="$*"
    echo -e "${BLUE}📋 Task:${NC} $TASK"
    echo ""
    echo -e "${GREEN}🚀 Launching Claude with SuperClaude context and your task...${NC}"
    echo ""

    # Navigate to project root
    cd "$PROJECT_ROOT"

    # Launch Claude with SuperClaude context and task
    claude --session-context="$SUPERCLAUDE_CONTEXT" "$TASK"
else
    # No task - interactive session
    echo -e "${GREEN}🚀 Launching interactive Claude session with SuperClaude context...${NC}"
    echo ""
    echo -e "${YELLOW}Tip: Specify personas like:${NC}"
    echo -e "  'As an architect, design a scalable auth system'"
    echo -e "  'From a security perspective, audit the OAuth flow'"
    echo ""
    echo -e "${YELLOW}Or use orchestration:${NC}"
    echo -e "  '/spawn-agent gemini \"Research WebSocket patterns\"'"
    echo -e "  'Orchestrate parallel: frontend UI, backend API, tests'"
    echo ""

    # Navigate to project root
    cd "$PROJECT_ROOT"

    # Launch Claude with SuperClaude context
    claude --session-context="$SUPERCLAUDE_CONTEXT"
fi
