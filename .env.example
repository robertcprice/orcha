# V5 Hybrid Orchestrator - Environment Configuration
# Copy this file to .env and fill in your API keys

# ==================== Required API Keys ====================

# OpenAI API Key (for ChatGPT planning)
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-...

# DeepSeek API Key (for plan enrichment)
# Get from: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-...

# Grok/xAI API Key (for creative review)
# Get from: https://x.ai/ (when available)
GROK_API_KEY=xai-...
# Alternative environment variable name
XAI_API_KEY=xai-...

# Google Gemini API Key (for documentation)
# Get from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=AIza...

# ==================== Optional API Keys ====================

# Perplexity API Key (if using multi_ai_research)
# PERPLEXITY_API_KEY=pplx-...

# Anthropic API Key (if using Claude API directly instead of CLI)
# ANTHROPIC_API_KEY=sk-ant-...

# ==================== Redis Configuration ====================

# Redis for event publishing (optional)
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0

# ==================== Orchestrator Configuration ====================

# Project root directory (default: current directory)
# PROJECT_ROOT=/path/to/your/project

# Maximum refinement iterations
# MAX_ITERATIONS=3

# Enable cost tracking
# ENABLE_COST_TRACKING=true

# Enable verbose logging
# VERBOSE=true

# ==================== Agent Configuration ====================

# ChatGPT model to use
# CHATGPT_MODEL=gpt-4o

# DeepSeek model to use
# DEEPSEEK_MODEL=deepseek-chat

# Grok model to use
# GROK_MODEL=grok-beta

# Gemini model to use
# GEMINI_MODEL=gemini-2.0-flash-exp

# ==================== Script Executor Configuration ====================

# Default script timeout (seconds)
# SCRIPT_TIMEOUT=300

# Maximum parallel executions
# MAX_PARALLEL_SCRIPTS=5

# ==================== Agent Dispatcher Configuration ====================

# Maximum Codex retries
# MAX_CODEX_RETRIES=2

# Maximum Claude retries
# MAX_CLAUDE_RETRIES=1

# ==================== Best Practices ====================

# Enable best practices injection
# ENABLE_BEST_PRACTICES=true
